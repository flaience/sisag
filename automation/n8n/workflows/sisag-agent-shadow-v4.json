      "typeVersion": 2,
      "position": [
        0,
        0
      ],
      "webhookId": "4578414e-786d-42f6-86bb-8632a4540cbb",
      "credentials": {
        "httpHeaderAuth": {
          "id": "ldRSXNbrCkLVqwnj",
          "name": "Header Auth account 4"
        }
      },
      "notes": "Vincule uma credencial Header Auth exclusiva para a entrada. Não reutilize o segredo interno do SISAG."
    },
    {
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "const body = $json.body ?? $json;\nif (!body || typeof body !== 'object' || !body.request || !body.toolCall) throw new Error('invalid_shadow_input');\nif (Object.prototype.hasOwnProperty.call(body, 'evidence')) throw new Error('caller_supplied_evidence_forbidden');\nreturn { json: { mode: 'shadow', receivedAt: new Date().toISOString(), correlationId: body.request?.trustedContext?.correlationId ?? null, gatewayInput: body } };"
      },
      "id": "12b7363a-2d33-4373-8a70-3cd7c55bc555",
      "name": "Prepare Shadow Input",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        240,
        0
      ],
      "notes": "Aceita somente request e toolCall. Evidência é sempre recuperada internamente pelo gateway."
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://sisag.flaience.com/api/platform/agents/n8n/shadow-decision",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": []
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ { request: $json.gatewayInput.request } }}",
        "options": {
          "response": {
            "response": {
              "responseFormat": "json"
            }
          },
          "timeout": 15000
        }
      },
      "id": "752f0109-0f4e-45cc-bc58-5747e6397053",
      "name": "Call SISAG Shadow Decision",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        528,
        0
      ],
      "credentials": {
        "httpHeaderAuth": {
          "id": "JM6Q9b9q0Yzsvxn6",
          "name": "Header Auth account 3"
        }
      },
      "notes": "Vincule a credencial de saída x-platform-internal-secret. Esta chamada só alcança o gateway read-only."
    },
    {
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "const prepared = $('Prepare Shadow Input').item.json;\nreturn { json: { mode: 'shadow', correlationId: prepared.correlationId, accepted: true, gatewayResult: $json, observedAt: new Date().toISOString(), sideEffects: 'none' } };"
      },
      "id": "cb347047-40f1-4174-b0bf-35f75a343092",
      "name": "Record Shadow Observation",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        120,
        0
      ],
      "notes": "A saída é efêmera no n8n. A API do SISAG registra somente metadados sanitizados, sem headers, telefone, mensagem ou dados da agenda."
    },
    {
      "parameters": {
        "respondWith": "json",
        "responseBody": "={{ { accepted: true, mode: 'shadow', correlationId: $json.correlationId, sideEffects: 'none', decision: { action: $json.gatewayResult.decision.action, toolName: $json.gatewayResult.decision.toolName, reasonCode: $json.gatewayResult.decision.reasonCode, confidence: $json.gatewayResult.decision.confidence }, execution: { mode: $json.gatewayResult.execution.mode, provider: $json.gatewayResult.execution.provider, model: $json.gatewayResult.execution.model, promptVersion: $json.gatewayResult.execution.promptVersion, durationMs: $json.gatewayResult.execution.durationMs, errorCode: $json.gatewayResult.execution.errorCode }, toolObservation: $json.toolObservation } }}",
        "options": {
          "responseCode": 202
        }
      },
      "id": "5fc42857-7357-4457-9d55-93f24c54f3bf",
      "name": "Respond Shadow Only",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.4,
      "position": [
        920,
        0
      ],
      "notes": "Confirma apenas a observação sombra ao chamador técnico."
    },
    {
      "id": "decision-requests-tool",
      "name": "Decision Requests Tool",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [
        340,
        0
      ],
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict",
            "version": 2
          },
          "conditions": [
            {
              "id": "shadow-tool-condition",
              "leftValue": "={{ $json.gatewayResult.decision.action }}",
              "rightValue": "request_read_only_tool",
              "operator": {
                "type": "string",
                "operation": "equals"
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      }
    },
    {
      "id": "execute-read-only-tool",
      "name": "Execute SISAG Read Only Tool",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        560,
        -120
      ],
      "parameters": {
        "method": "POST",
        "url": "https://sisag.flaience.com/api/platform/agents/n8n/read-only",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": []
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ { request: $('Prepare Shadow Input').item.json.gatewayInput.request, toolCall: { name: $('Record Shadow Observation').item.json.gatewayResult.decision.toolName, arguments: Object.fromEntries(Object.entries($('Record Shadow Observation').item.json.gatewayResult.decision.toolArguments).filter(([, value]) => value !== null && value !== undefined)) } } }}",
        "options": {
          "response": {
            "response": {
              "responseFormat": "json",
              "neverError": true
            }
          },
          "timeout": 15000
        }
      },
      "credentials": {
        "httpHeaderAuth": {
          "id": "JM6Q9b9q0Yzsvxn6",
          "name": "Header Auth account 3"
        }
      },
      "notes": "Executa somente o gateway allowlisted read-only; nenhum dado retornado é enviado ao WhatsApp."
    },
    {
      "id": "record-tool-observation",
      "name": "Record Tool Observation",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        760,
        -120
      ],
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "const observed = $('Record Shadow Observation').item.json;\nreturn { json: { ...observed, toolObservation: { requested: true, status: $json.ok === true ? 'succeeded' : 'failed', errorCode: $json.ok === true ? null : ($json.error ?? 'read_only_tool_failed'), policyVersion: $json.policyVersion ?? null } } };"
      }
    },
    {
      "id": "record-no-tool-observation",
      "name": "Record No Tool Observation",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        760,
        120
      ],
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "return { json: { ...$json, toolObservation: { requested: false, status: 'skipped', errorCode: null, policyVersion: null } } };"
      }
    }
