      "parameters": {
        "jsCode": "const input = $input.first().json;\nlet response = input;\nconst responseBytes = input?._readableState?.buffer?.[0]?.data;\nif (Array.isArray(responseBytes)) {\n  try {\n    response = JSON.parse(String.fromCharCode(...responseBytes));\n  } catch {\n    throw new Error(\"post_activation_due_runner_invalid_json_response\");\n  }\n} else if (typeof input === \"string\") {\n  response = JSON.parse(input);\n} else if (typeof input?.body === \"string\") {\n  response = JSON.parse(input.body);\n} else if (input?.body && typeof input.body === \"object\") {\n  response = input.body;\n}\nif (response?.ok !== true || !response?.data) {\n  throw new Error(\"post_activation_due_runner_failed\");\n}\nif (response.data.failed > 0) {\n  throw new Error(`post_activation_due_runner_partial_failure:${response.data.failed}`);\n}\nreturn [{ json: {\n  executedAt: new Date().toISOString(),\n  scanned: response.data.scanned,\n  due: response.data.due,\n  processed: response.data.processed,\n  waiting: response.data.waiting,\n  completed: response.data.completed,\n  escalated: response.data.escalated,\n  plansCompleted: response.data.plansCompleted,\n  failed: response.data.failed,\n} }];"
