        "jsCode": "const envelope = $json.body;\nif (!envelope || envelope.eventType !== \"commercial.onboarding.execution_requested\") {\n  throw new Error(\"invalid_commercial_onboarding_event\");\n}\nif (!envelope.outboxId || !envelope.payload?.command?.key) {\n  throw new Error(\"invalid_commercial_onboarding_envelope\");\n}\nreturn [{ json: { runtimeEvent: envelope } }];"
