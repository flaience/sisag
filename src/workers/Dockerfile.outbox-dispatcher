/**
 * Outbox Dispatcher (standalone)
 * - NÃO usa "@/..." nem imports do app
 * - Roda só com Node + pg
 *
 * Env:
 *   DATABASE_URL ou DATABASE_URL_FILE
 *   N8N_WEBHOOK_URL
 *   N8N_WEBHOOK_SECRET (opcional)
 *   DISPATCH_BATCH_SIZE (default 10)
 *   DISPATCH_INTERVAL_MS (default 2000)
 *   N8N_TIMEOUT_MS (default 8000)
 *   OUTBOX_MAX_ATTEMPTS (default 8)
 */

const fs = require("fs");
const { Pool } = require("pg");

function readFileIfExists(path) {
  try {
    if (!path) return null;
    return fs.readFileSync(path, "utf8").trim();
  } catch {
    return null;
  }
}

function required(name, val) {
  if (!val) throw new Error(`[dispatcher] missing env ${name}`);
  return val;
}

function sleep(ms) {
  return new Promise((r) => setTimeout(r, ms));
}

function parseIntEnv(name, def) {
  const v = process.env[name];
  if (!v) return def;
  const n = Number(v);
  return Number.isFinite(n) ? n : def;
}

function nowIso() {
  return new Date().toISOString();
}

function addSeconds(sec) {
  return new Date(Date.now() + sec * 1000).toISOString();
}

async function postJson(url, body, headers) {
  const timeoutMs = parseIntEnv("N8N_TIMEOUT_MS", 8000);
  const ac = new AbortController();
  const t = setTimeout(() => ac.abort(), timeoutMs);

  try {
    const res = await fetch(url, {
      method: "POST",
      headers: { "content-type": "application/json", ...headers },
      body: JSON.stringify(body),
      signal: ac.signal,
    });
    const text = await res.text().catch(() => "");
    return { ok: res.ok, status: res.status, text };
  } finally {
    clearTimeout(t);
  }
}

function isRetryableStatus(status) {
  // retry em 429 / 5xx
  return status === 429 || (status >= 500 && status <= 599);
}

function backoffSeconds(attempts) {
  // 5s, 10s, 20s, 40s ... cap 5 min
  const base = 5 * Math.pow(2, Math.max(0, attempts - 1));
  return Math.min(base, 300);
}

async function main() {
  const databaseUrl =
    process.env.DATABASE_URL ||
    readFileIfExists(process.env.DATABASE_URL_FILE);

  const n8nUrl = process.env.N8N_WEBHOOK_URL || process.env.N8N_TARGET_URL;
  const n8nSecret = process.env.N8N_WEBHOOK_SECRET || process.env.OUTBOX_WEBHOOK_SECRET || "";

  required("DATABASE_URL or DATABASE_URL_FILE", databaseUrl);
  required("N8N_WEBHOOK_URL", n8nUrl);

  const batchSize = parseIntEnv("DISPATCH_BATCH_SIZE", 10);
  const intervalMs = parseIntEnv("DISPATCH_INTERVAL_MS", 2000);
  const maxAttempts = parseIntEnv("OUTBOX_MAX_ATTEMPTS", 8);

  const pool = new Pool({
    connectionString: databaseUrl,
    max: parseIntEnv("PG_POOL_SIZE", 5),
    ssl: process.env.PG_SSL === "true" ? { rejectUnauthorized: false } : undefined,
  });

  console.log("[dispatcher] started", {
    batchSize,
    intervalMs,
    maxAttempts,
    n8nUrl,
    hasSecret: Boolean(n8nSecret),
  });

  while (true) {
    const client = await pool.connect();
    try {
      await client.query("BEGIN");

      // pega pendentes (inclui retry ready)
      const { rows } = await client.query(
        `
        SELECT id, event_type, payload, attempts
        FROM outbox
        WHERE
          (status = 'pending')
          OR (status = 'failed' AND next_retry_at IS NOT NULL AND next_retry_at <= now())
        ORDER BY created_at ASC
        LIMIT $1
        FOR UPDATE SKIP LOCKED
        `,
        [batchSize],
      );

      if (rows.length === 0) {
        await client.query("COMMIT");
        client.release();
        await sleep(intervalMs);
        continue;
      }

      // marca como processing e lock
      const ids = rows.map((r) => r.id);
      await client.query(
        `
        UPDATE outbox
        SET
          status = 'processing',
          locked_at = now(),
          locked_by = $2,
          updated_at = now()
        WHERE id = ANY($1::uuid[])
        `,
        [ids, process.env.WORKER_ID || "outbox-dispatcher"],
      );

      await client.query("COMMIT");
      client.release();

      // processa fora da transação
      for (const evt of rows) {
        const headers = n8nSecret ? { "x-outbox-secret": n8nSecret } : {};
        const body = {
          outboxId: evt.id,
          eventType: evt.event_type,
          payload: evt.payload,
        };

        const r = await postJson(n8nUrl, body, headers);

        const c2 = await pool.connect();
        try {
          if (r.ok) {
            await c2.query(
              `
              UPDATE outbox
              SET
                status = 'done',
                last_error = NULL,
                next_retry_at = NULL,
                locked_at = NULL,
                locked_by = NULL,
                updated_at = now()
              WHERE id = $1
              `,
              [evt.id],
            );
            console.log("[dispatcher] dispatched", {
              outboxId: evt.id,
              eventType: evt.event_type,
              status: r.status,
            });
          } else {
            const attempts = Number(evt.attempts || 0) + 1;
            const willRetry = attempts < maxAttempts && isRetryableStatus(r.status);
            const nextRetry = willRetry ? addSeconds(backoffSeconds(attempts)) : null;

            await c2.query(
              `
              UPDATE outbox
              SET
                status = $2,
                attempts = $3,
                last_error = $4,
                next_retry_at = $5,
                locked_at = NULL,
                locked_by = NULL,
                updated_at = now()
              WHERE id = $1
              `,
              [
                evt.id,
                willRetry ? "failed" : "failed",
                attempts,
                `n8n_status=${r.status} body=${String(r.text).slice(0, 500)}`,
                nextRetry,
              ],
            );

            console.log("[dispatcher] failed", {
              outboxId: evt.id,
              eventType: evt.event_type,
              status: r.status,
              attempts,
              nextRetryAt: nextRetry,
            });
          }
        } finally {
          c2.release();
        }
      }
    } catch (err) {
      try {
        await client.query("ROLLBACK");
      } catch {}
      client.release();
      console.error("[dispatcher] loop error", err);
      await sleep(intervalMs);
    }
  }
}

main().catch((e) => {
  console.error("[dispatcher] fatal", e);
  process.exit(1);
});
