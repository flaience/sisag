# Dockerfile.outbox-dispatcher
FROM node:20-alpine

WORKDIR /app

# deps mínimas pro dispatcher standalone
RUN npm init -y >/dev/null 2>&1 && npm i pg@8 >/dev/null 2>&1

# copia o dispatcher (standalone)
COPY src/workers/outbox-dispatcher.cjs /app/outbox-dispatcher.cjs

CMD ["node", "/app/outbox-dispatcher.cjs"]
