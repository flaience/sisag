FROM node:20-alpine
WORKDIR /app

# Você vai passar o caminho real via build-arg (ex: src/infra/outbox/outbox-dispatcher.js ou dist/outbox-dispatcher.js)
ARG DISPATCHER_SRC

# Falha com mensagem clara se não vier
RUN test -n "$DISPATCHER_SRC" || (echo "DISPATCHER_SRC is required" && exit 1)

# Copia o arquivo real do repo para o path que o container espera
COPY ${DISPATCHER_SRC} /app/outbox-dispatcher.js

CMD ["node", "/app/outbox-dispatcher.js"]
