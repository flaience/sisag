# Dockerfile.outbox-dispatcher
FROM node:20-alpine

WORKDIR /app

# deps (precisa do pg)
COPY package.json pnpm-lock.yaml ./

RUN rm -rf /root/.cache/node/corepack \
  && corepack enable \
  && corepack prepare pnpm@9.12.1 --activate \
  && pnpm i --prod --frozen-lockfile

# copia o dispatcher REAL do repo
COPY src/workers/outbox-dispatcher.js /app/outbox-dispatcher.js

CMD ["node", "/app/outbox-dispatcher.js"]
