# Dockerfile.outbox-dispatcher
FROM node:20-alpine

WORKDIR /app

# deps (precisa do pg)
COPY package.json pnpm-lock.yaml ./
RUN corepack enable && pnpm i --prod --frozen-lockfile

# copia o dispatcher REAL do repo
COPY src/workers/outbox-dispatcher.js /app/outbox-dispatcher.js

CMD ["node", "/app/outbox-dispatcher.js"]
