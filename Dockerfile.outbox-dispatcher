FROM node:20-alpine

WORKDIR /app

# pnpm via corepack
RUN corepack enable

# deps do repo (usa o lock do root)
COPY package.json pnpm-lock.yaml ./
RUN pnpm install --prod --frozen-lockfile

# copia o dispatcher REAL do repo
COPY src/workers/outbox-dispatcher.js /app/outbox-dispatcher.js

CMD ["node", "/app/outbox-dispatcher.js"]
