# Dockerfile.whatsapp-worker

# ---------- build ----------
FROM node:20-alpine AS build
WORKDIR /app

RUN corepack enable

# lockfile REAL do seu repo (na raiz)
COPY package.json ./package.json
COPY pnpm-lock.yaml ./pnpm-lock.yaml

RUN pnpm install --frozen-lockfile

# copia o worker
COPY src/services/sisag-whatsapp-worker ./src/services/sisag-whatsapp-worker

# compila SEM chamar "tsc" como executável (evita Permission denied)
WORKDIR /app/src/services/sisag-whatsapp-worker
RUN node /app/node_modules/typescript/bin/tsc -p tsconfig.json

# ---------- runtime ----------
FROM node:20-alpine
WORKDIR /app

ENV NODE_ENV=production

COPY --from=build /app/src/services/sisag-whatsapp-worker/dist ./dist
COPY --from=build /app/node_modules ./node_modules
COPY --from=build /app/package.json ./package.json

CMD ["node", "dist/index.js"]
