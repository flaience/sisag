# Dockerfile.whatsapp-worker

# ---------- build ----------
FROM node:20-alpine AS build
WORKDIR /app

RUN corepack enable

COPY src/services/sisag-whatsapp-worker/package.json ./package.json
COPY src/services/sisag-whatsapp-worker/pnpm-lock.yaml ./pnpm-lock.yaml
COPY src/services/sisag-whatsapp-worker/tsconfig.json ./tsconfig.json

RUN pnpm install --frozen-lockfile

COPY src/services/sisag-whatsapp-worker/src ./src

RUN pnpm build

# ---------- runtime ----------
FROM node:20-alpine
WORKDIR /app

ENV NODE_ENV=production

COPY --from=build /app/node_modules ./node_modules
COPY --from=build /app/dist ./dist
COPY --from=build /app/package.json ./package.json

CMD ["node", "dist/index.js"]
